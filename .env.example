# Copy to .env and fill in. .env is git-ignored - never commit real keys.

LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
LLM_MODEL=z-ai/glm-5.2

# Other providers (optional)
# ZAI_API_KEY=
# MOONSHOT_API_KEY=

# Tried in order if the main model fails (free models are often busy)
LLM_FALLBACK_MODELS=nvidia/nemotron-3.5-super-vl:free,google/gemma-4-31b-it:free

# ---- Sign-in (accounts). With SUPABASE_URL set, AUTH_MODE defaults to supabase; otherwise local.
# AUTH_MODE=supabase            # supabase = Google / email link via Supabase; local = 6-digit email code
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_ANON_KEY=<anon public key>   # public by design. NEVER put the service_role key here.
# SUPABASE_PROVIDERS=google,email
# Local mode only: without SMTP the code is shown on the page (demo inbox).
# SMTP_HOST= SMTP_PORT=587 SMTP_USER= SMTP_PASSWORD= EMAIL_FROM=
# FREE_SCANS_PER_DAY=5  FREE_SCANS_PER_IP_PER_DAY=15  ACCOUNTS_PER_IP_PER_DAY=3
